<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the AetherFrame server (docs/networking/NETWORK2.md, N2-7). The server runs in memory
    on ASP.NET Core's test host with a database in a temporary folder, a manual clock, and a fake
    Lodestone: nothing here opens a connection to anything, and every key is made for the test.
  -->

  <Import Project="..\..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AetherFrame.Server.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherFrame.Server\AetherFrame.Server.csproj" />
    <ProjectReference Include="..\AetherFrame.ImageWorker\AetherFrame.ImageWorker.csproj" />
    <ProjectReference Include="..\AetherFrame.LodestoneRelay\AetherFrame.LodestoneRelay.csproj" />
  </ItemGroup>

  <!-- The plugin's client for this server (docs/networking/NETWORK2.md, N2-9a), compiled here so
       its tests run it against the real server in memory. It is Dalamud-free by design. -->
  <ItemGroup>
    <Compile Include="..\..\AetherFrame\Services\Network\Transport\SharingClient.cs" Link="Linked\Plugin\SharingClient.cs" />
  </ItemGroup>

  <!-- The same test packages, at the same versions, as the other test projects. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
