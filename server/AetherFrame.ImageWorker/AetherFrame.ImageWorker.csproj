<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The image worker (docs/networking/NETWORK2.md, N2-7c; decision I2): it decodes an uploaded image
    and encodes it again, one job per run, in a container of its own with no network, no database, no
    key and no configuration (N2-8). It connects to the socket the server owns, answers one job, and
    ends; a watchdog ends it if a job runs too long.

    SixLabors.ImageSharp is pinned by the lock file to 4.1.2, which fixes Six Labors' advisories of
    August and September 2026 (DecisionRegister.md, N2-7c). ImageSharp 4 checks a signed licence key
    at build time, under the owner's Six Labors licence. A local build names the owner's licence file
    with the SixLaborsLicenseFile property; elsewhere the key comes from the SIXLABORS_LICENSE_KEY
    environment variable, mapped below unless SixLaborsLicenseKey is already set. The key is never
    written into the repository, an image layer or a log.
  -->

  <Import Project="..\..\Version.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AetherFrame.ImageWorker</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ImageJobs.cs" Link="Shared\ImageJobs.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

</Project>
