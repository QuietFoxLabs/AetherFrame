<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- The product version (and so the assembly and Dalamud manifest versions) comes from here only. -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>richhiiee</Author>
    <Name>AetherFrame</Name>
    <Punchline>Design character Plates in a familiar Basic Editor or a freeform Advanced Editor.</Punchline>
    <!-- The last sentence is the AI-generated asset disclosure (icon and bundled artwork) that the
         Dalamud AI Usage Policy requires in the plugin description
         (https://dalamud.dev/plugin-publishing/ai-policy). -->
    <Description>Design character Plates: start from an Adventure Plate-style layout in the Basic Editor, or build freeform layouts with text, images and decorative Components in the Advanced Editor. The plugin icon is AI-generated, and the bundled Celestial Dream and Celestial Sakura Components use AI-assisted artwork.</Description>
    <RepoUrl>https://github.com/QuietFoxLabs/AetherFrame</RepoUrl>
    <Tags>aetherframe;plates;adventure-plate;profile;customization</Tags>
    <!-- Approved icon (images/icon.png, 512 x 512), pinned to the commit that added it. DalamudPackager
         copies this URL into the plugin manifest, so every released package keeps it for good: pinning
         means only a reviewed change to this line and a new release can change the icon players see,
         and moving the file or renaming a branch can't remove it. The file is not part of the package. -->
    <IconUrl>https://raw.githubusercontent.com/QuietFoxLabs/AetherFrame/8b716efece4a3077ed3345dfcf491ddcfcab52db/AetherFrame/images/icon.png</IconUrl>
  </PropertyGroup>

  <!-- Curated portable fonts (PT Sans, PT Serif, Cousine — SIL Open Font License 1.1, see
       Fonts/THIRD-PARTY-FONT-LICENSES.txt), embedded so profile text renders identically on
       every machine without depending on locally-installed Windows fonts. Loaded at runtime via
       ProfileFontService through the logical resource names set here. -->
  <ItemGroup>
    <None Remove="Fonts\*.ttf" />
    <EmbeddedResource Include="Fonts\*.ttf">
      <LogicalName>AetherFrame.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Built-in Component artwork (optimized runtime copies; the full-size sources live in
       a separate repository that no longer exists, and are never needed at runtime). Embedded, never copied to the output
       folder, and addressed only by manifest resource name: "AetherFrame.Assets." + the path
       below Assets with '.' separators (see BuiltInArtCatalog). Plates store logical ids only. -->
  <ItemGroup>
    <None Remove="Assets\**" />
    <EmbeddedResource Include="Assets\**\*.png">
      <LogicalName>AetherFrame.Assets.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
