<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- The product version (and so the assembly and Dalamud manifest versions) comes from here only. -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>richhiiee</Author>
    <Name>AetherFrame</Name>
    <Punchline>Design character Plates in a familiar Basic Editor or a freeform Advanced Editor.</Punchline>
    <!-- The last sentence is the AI-generated asset disclosure (icon and bundled artwork) that the
         Dalamud AI Usage Policy requires in the plugin description
         (https://dalamud.dev/plugin-publishing/ai-policy). -->
    <Description>Design character Plates: start from an Adventure Plate-style layout in the Basic Editor, or build freeform layouts with text, images and decorative Components in the Advanced Editor. Optional sharing (alpha), off until you turn it on for a character, sends that character's name, World, Lodestone id and Active Plate to AetherFrame's server so other players who share can view it; viewing a Plate sends the name and World you look up. Checking a character, and reading its Lodestone page again later while you use sharing, goes through your own internet connection, so the Lodestone sees your network address. An Art Style's artwork downloads from GitHub the first time you use it, and is kept on your PC. The plugin icon is AI-generated, and the Art Styles and the Celestial Dream and Celestial Sakura Components use AI-assisted artwork.</Description>
    <RepoUrl>https://github.com/QuietFoxLabs/AetherFrame</RepoUrl>
    <Tags>aetherframe;plates;adventure-plate;profile;customization</Tags>
    <!-- Approved icon (images/icon.png, 512 x 512), pinned to the commit that added it. DalamudPackager
         copies this URL into the plugin manifest, so every released package keeps it for good: pinning
         means only a reviewed change to this line and a new release can change the icon players see,
         and moving the file or renaming a branch can't remove it. The file is not part of the package. -->
    <IconUrl>https://raw.githubusercontent.com/QuietFoxLabs/AetherFrame/8b716efece4a3077ed3345dfcf491ddcfcab52db/AetherFrame/images/icon.png</IconUrl>
  </PropertyGroup>

  <!-- Curated portable fonts (PT Sans, PT Serif, Cousine — SIL Open Font License 1.1, see
       Fonts/THIRD-PARTY-FONT-LICENSES.txt), and the font library below, embedded so profile text renders identically on
       every machine without depending on locally-installed Windows fonts. Loaded at runtime via
       ProfileFontService through the logical resource names set here. -->
  <ItemGroup>
    <None Remove="Fonts\*.ttf" />
    <EmbeddedResource Include="Fonts\*.ttf">
      <LogicalName>AetherFrame.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The font library (tools/fonts; Fonts/Library/THIRD-PARTY-FONT-LICENSES.txt). -->
    <None Remove="Fonts\Library\*.ttf" />
    <EmbeddedResource Include="Fonts\Library\*.ttf">
      <LogicalName>AetherFrame.Fonts.Library.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The fonts' licences travel with them, shown from Help (FontLicencesWindow). -->
    <EmbeddedResource Include="Fonts\THIRD-PARTY-FONT-LICENSES.txt" LogicalName="AetherFrame.Fonts.THIRD-PARTY-FONT-LICENSES.txt" />
    <EmbeddedResource Include="Fonts\Library\THIRD-PARTY-FONT-LICENSES.txt" LogicalName="AetherFrame.Fonts.Library.THIRD-PARTY-FONT-LICENSES.txt" />
  </ItemGroup>

  <!-- Built-in artwork the plugin carries: the Art Styles' preview cards, so the Theme browser shows
       every style before anything is downloaded, and Celestial Dream's Astrolabe (tintable, in no
       style). Every other runtime PNG under Assets\Components is hosted and downloaded the first
       time a player uses it (art on demand, "Art on demand" in docs/networking/DecisionRegister.md;
       AetherFrame/Assets/ArtFiles.txt). Embedded, never copied to the output folder, and addressed
       only by manifest resource name: "AetherFrame.Assets." + the path below Assets with '.'
       separators (see BuiltInArtCatalog). Plates store logical ids only. -->
  <ItemGroup>
    <None Remove="Assets\**" />
    <EmbeddedResource Include="Assets\StylePreviews\*.png">
      <LogicalName>AetherFrame.Assets.StylePreviews.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Components\CelestialDream\**\*.png">
      <LogicalName>AetherFrame.Assets.Components.CelestialDream.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The networking preview flavour (docs/networking/DecisionRegister.md, D9b and P2). A player
       build compiles none of this, so AetherFrame.dll holds no protocol or persona code at all. A
       preview build (dotnet build -p:AetherFrameNetworkPreview=true) compiles the canonical sources
       of AetherFrame.Protocol and AetherFrame.Personas into AetherFrame.dll, keeping the release
       package at the same three files whichever flavour is built, and defines
       AETHERFRAME_NETWORK_PREVIEW for the composition root. The preview flavour carries the sharing
       server's client (Services/Network/Transport, decision R3), HTTP only, through Dalamud's connect
       callback; it exists so the networking increments have a place to be built and checked, and so
       a tester can tell the flavours apart (/af version). -->
  <!-- Since the owner's direction of October 1, 2026 ("Testing channel gets sharing"), the sharing
       flavour is the build: released from 0.1.8 on (distribution/repository.json's sharingSince),
       tested and handed out. -p:AetherFrameNetworkPreview=false still builds the player flavour,
       with no networking code at all, which CI keeps compiling. Warnings are errors in every
       flavour, as they were for the networking code before it shipped. -->
  <PropertyGroup>
    <AetherFrameNetworkPreview Condition="'$(AetherFrameNetworkPreview)' == ''">true</AetherFrameNetworkPreview>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AetherFrameNetworkPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);AETHERFRAME_NETWORK_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(AetherFrameNetworkPreview)' == 'true'">
    <Compile Include="..\AetherFrame.Protocol\**\*.cs" Exclude="..\AetherFrame.Protocol\obj\**;..\AetherFrame.Protocol\bin\**" Link="Network\Protocol\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame.Personas\**\*.cs" Exclude="..\AetherFrame.Personas\obj\**;..\AetherFrame.Personas\bin\**" Link="Network\Personas\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The plugin's own networking folders are preview-only too: a player build compiles nothing in them. -->
  <ItemGroup Condition="'$(AetherFrameNetworkPreview)' != 'true'">
    <Compile Remove="Services\Network\**;Hosting\Network\**;Windows\Network\**" />
  </ItemGroup>
</Project>
