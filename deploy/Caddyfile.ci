# CI only: the deployment's Caddyfile on plain HTTP, since CI has no domain to certify.
{
	log default {
		exclude http.log.error http.handlers.reverse_proxy http.stdlib
	}
}

:80 {
	request_body {
		max_size 43MB
	}

	@lodestone path /v1/lodestone/check /v1/lodestone/reread
	reverse_proxy @lodestone server:8080 {
		stream_timeout 60s
	}

	reverse_proxy server:8080

	header {
		-Server
	}
}
