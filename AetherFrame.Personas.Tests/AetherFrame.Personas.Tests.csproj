<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the persona management foundation (docs/networking/NETWORK1_PersonaFoundation.md).
    Every key here is a synthetic P-256 key made for the test process and discarded with it; the
    key store and backup codec are in-memory test doubles that carry no key material in any bytes
    they produce. Nothing reads or writes AetherFrame user data, saved Plates or the Dalamud
    configuration, and nothing opens a connection.
  -->

  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AetherFrame.Personas.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherFrame.Personas\AetherFrame.Personas.csproj" />
    <ProjectReference Include="..\AetherFrame.Protocol\AetherFrame.Protocol.csproj" />
  </ItemGroup>

  <!-- The plugin's Dalamud-free key custody code, part of the sharing build (the default since
       October 1, 2026; the player flavour, -p:AetherFrameNetworkPreview=false, leaves it out), is
       compiled into this test assembly from its source so it is tested on every build: the key blob
       storage (a directory of files, System.IO only), the DPAPI protector (crypt32 on Windows,
       refusing elsewhere) and the capability probe. -->
  <ItemGroup>
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaKeyFileStorage.cs" Link="Linked\PersonaKeyFileStorage.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\WrittenThroughMove.cs" Link="Linked\WrittenThroughMove.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaRegistryFileStorage.cs" Link="Linked\PersonaRegistryFileStorage.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaInstanceLock.cs" Link="Linked\PersonaInstanceLock.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\NoBackupCodec.cs" Link="Linked\NoBackupCodec.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaSession.cs" Link="Linked\PersonaSession.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaPaths.cs" Link="Linked\PersonaPaths.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\DpapiPersonaKeyProtector.cs" Link="Linked\DpapiPersonaKeyProtector.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Personas\PersonaCapabilityProbe.cs" Link="Linked\PersonaCapabilityProbe.cs" />
  </ItemGroup>

  <!-- The approved public surface, copied next to the test binaries byte for byte
       (Fixtures/.gitattributes keeps git from rewriting its line endings). -->
  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The same test packages, at the same versions, as the other test projects. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
